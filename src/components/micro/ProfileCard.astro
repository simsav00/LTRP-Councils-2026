---
import MutedText from "./MutedText.astro";

 const { class: className, pfp, username, role, } = Astro.props;
---

<div class={`border-2 border-elevated-2 px-3.5 py-6 bg-elevated-1 rounded-xl flex flex-col items-center gap-2 ${className ?? ""}`}>
    <img src={pfp} alt={`${username ?? "User Name"}'s profile picture.'`}
         class="rounded-full border-4 border-elevated-2 max-w-32 w-full mb-4"
    >

    <h3 class="text-xl">{username}</h3>
    
    <MutedText>
        {role}
    </MutedText>
</div>