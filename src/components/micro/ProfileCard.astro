---
import MutedText from "./MutedText.astro";
import Container from "../nano/Container.astro";

 const { class: className, pfp, username, role, } = Astro.props;
---

<Container class={`flex flex-col items-center gap-2 py-4 ${className ?? ""}`}>
    <img src={pfp} alt={`${username ?? "User Name"}'s profile picture.'`}
         class="rounded-full border-4 border-elevated-2 max-w-32 w-full mb-2"
    >

    <h3 class="text-xl">{username}</h3>
    
    <MutedText>
        {role}
    </MutedText>
</Container>   
                                                                                                       