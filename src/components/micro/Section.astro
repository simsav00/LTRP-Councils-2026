---
const {
    title = null,
    titleProps = {},
    defaultStyles = true,
    class: className,
    ...props
} = Astro.props;
---

<section class="flex gap-2 flex-col">
    {
        title && (
            <h2
                data-symbol="/ "
                class={`font-secondary border-elevated-5 border-b-2 text-3xl font-bold pb-2 before:content-[attr(data-symbol)]
                    ${titleProps?.disableBorderBottom ? "" : "border-b"} ${titleProps?.class ?? ""}
                `}
                {...titleProps}
            >
                {title ?? ""}
            </h2>
        )
    }

    <div
        {...props}
        class={`${defaultStyles ? "flex gap-2 flex-col" : ""} ${className ?? ""}`}
    >
        <slot />
    </div>
</section>
