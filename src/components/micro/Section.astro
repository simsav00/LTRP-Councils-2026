---
const { 
    title,
    titleProps = {},
    contentProps = {},
    defaultStyles = true,
    class: className,
 } = Astro.props;
---

<section class="flex gap-2 flex-col">
    <h2 class={`font-secondary border-elevated-6 text-2xl font-bold pb-2 ${titleProps?.disableBorderBottom ? "" : "border-b"} ${titleProps?.class ?? ""}`} {...titleProps}>{title ?? ""}</h2>

    <div {...contentProps} class={`${defaultStyles ? "flex gap-2 flex-col" : ""} ${className ?? ""}`}>
        <slot/>
    </div>
</section>